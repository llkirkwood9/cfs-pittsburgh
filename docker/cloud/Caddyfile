# HTTPS in front of the app on the cloud droplet (docker-compose.cloud.yml). Caddy gets and renews
# the Let's Encrypt certificate for CFS_DOMAIN by itself, and sends plain HTTP to HTTPS - so the
# domain has to point at the droplet, and ports 80 and 443 have to reach it.
#
# It passes the visitor's address and the original scheme on in X-Forwarded-For and
# X-Forwarded-Proto, which the app believes from this one hop (ForwardedHeaders__ForwardLimit=1).
{$CFS_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
}
