# Copy to .env (never committed) and pick the server this copy of the app talks to. Expo reads it
# when the bundler starts, so restart `npx expo start` after changing it.
#
# A local API (dotnet run in api/). A phone or emulator can't reach "localhost" on your PC - use
# your PC's IP address instead, e.g. http://192.168.1.20:5046 (Android emulator: 10.0.2.2:5046).
EXPO_PUBLIC_API_URL=http://localhost:5046
#
# Or the live site. Release builds get it from the API_URL repository secret instead.
# EXPO_PUBLIC_API_URL=https://<the live site>
