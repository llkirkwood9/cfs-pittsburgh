{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@shared/*": [
        "../shared/*"
      ],
      "@host": [
        "./src/Lib/Host.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "axios": [
        "./node_modules/axios"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "../shared/**/*.ts",
    "../shared/**/*.tsx"
  ]
}
